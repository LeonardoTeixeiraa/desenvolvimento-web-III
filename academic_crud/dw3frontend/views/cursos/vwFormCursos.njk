{% extends "layout.njk" %}
{% block content %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<header class="page-header">
  <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
  <h1 class="h3 fw-bold mb-2">Formulário de cursos</h1>
  <p class="text-secondary mb-0">Informe os dados cadastrais do curso.</p>
</header>

<div class="card page-card border-0 shadow-sm">
  <div class="card-body p-4">
    <form id="frmCursos" action="/cursos/insertCursos" method="post" data-servidor-dw3="{{ servidorDw3 }}">
      <input type="hidden" id="cursoid" name="cursoid" value="{{ data.cursoid or 0 }}">
      <input type="hidden" id="deleted" name="deleted" value="false">

      <div class="row g-3">
        <div class="col-12 col-md-3">
          <label for="codigo" class="form-label">Código</label>
          <input type="text" class="form-control" id="codigo" name="codigo" value="{{ data.codigo or '' }}" required>
        </div>
        <div class="col-12 col-md-9">
          <label for="descricao" class="form-label">Descrição</label>
          <input type="text" class="form-control" id="descricao" name="descricao" value="{{ data.descricao or '' }}" required>
        </div>
        <div class="col-12 col-md-3">
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="ativo" name="ativo" value="true" {% if data.ativo %}checked{% endif %}>
            <label class="form-check-label" for="ativo">Ativo</label>
          </div>
        </div>
      </div>

      <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
        <button type="submit" class="btn btn-primary" id="btnInserirCurso">
          <i class="bi bi-plus-lg me-1"></i>Inserir
        </button>
        <a class="btn btn-outline-secondary" href="/cursos" id="btnFecharCurso">
          <i class="bi bi-x-lg me-1"></i>Fechar
        </a>
      </div>
    </form>
  </div>
</div>

<script src="/js/dw3frontend.js"></script>
{% endblock %}
